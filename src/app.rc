#include <windows.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 1,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "RTXPlayer - RTX Super Resolution & Frame Interpolation Player"
            VALUE "FileVersion", "1.1.1.0"
            VALUE "ProductName", "RTXPlayer"
            VALUE "ProductVersion", "1.1.1.0"
            VALUE "OriginalFilename", "RTXPlayer.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
